# Aqualuxis Light - Backend Environment Configuration

# Express Server Port
PORT=5000

# Gmail Account Used to Send Emails (SMTP)
EMAIL_USER=integralwebsolution@gmail.com

# 16-character Google App Password for integralwebsolution@gmail.com
# (Generate in Google Account -> Security -> 2-Step Verification -> App Passwords)
EMAIL_PASS=your_gmail_app_password_here

# Inquiry Notification Recipients (3-Way Email Distribution)
# 1. Person who filled form (uses the email entered in form)
# 2. Aqualuxis Light Primary Inbox:
ADMIN_EMAIL_PRIMARY=info@aqualuxislight.com
# 3. Agency Notification Inbox:
ADMIN_EMAIL_SECONDARY=integralwebsolution@gmail.com

# Optional Backend URL for Next.js proxy/rewrites
BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000
